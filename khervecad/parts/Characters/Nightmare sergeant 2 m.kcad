 },
 "library": {
  "title": "Nightmare sergeant 2 m",
  "description": "A horror villain soldier for games: the Commando sergeant 2 m (muscular SWAT-based soldier, scaled to ~2 m, sculpted shoulders, arms, back and thighs, vest and backpack removed, visor off with modelled eyes) in a blood-red costume (#8E1B1B), wearing a bladed glove on his RIGHT hand (module Bladed_glove, world mm): one steel blade per finger, each placed by a multmatrix along THAT finger's own axis (measured from the hand mesh), so the four blades splay with the fingers \u2014 a strip along the back of the finger, then a 2.5 mm blade curving toward the palm ~200 mm past the tip \u2014 with leather caps, rings and a knuckle plate. Keeps the duty belt and holstered pistol, knee and elbow pads, shoulder patches and helmet with headset. Stands on z = 0, facing -Y. Static (no skeleton). The plain green version without blades is \"Commando sergeant 2 m\".",
  "tags": [
   "soldier",
   "horror",
   "villain",
   "claws",
   "finger blades",
   "red costume",
   "character",
   "game",
   "monster",
   "muscular"
  ],
  "source": "assistant",
  "uid": "1945f2039d994ad996dd7632dde8c39c",
  "created": "2026-10-16T14:32:15"
 }
