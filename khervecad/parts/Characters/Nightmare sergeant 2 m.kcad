     "library": {
      "uid": "1945f2039d994ad996dd7632dde8c39c",
      "title": "Commando sergeant 2 m",
      "area": "Characters & monsters",
      "named": "Commando sergeant 2 m",
      "source": "assistant",
      "description": "A big, muscular soldier for games, made from the SWAT soldier 1.8 m (Quaternius CC0 low-poly body). Scaled to about 2.0 m tall and ~20 % broader and deeper (scale 1.22 x 1.2 x 1.12 node \"Bigger and broader\"), with sculpt inflate strokes (mirrored in x) bulking the shoulders, upper arms, forearms, upper back, neck and thighs. Olive-drab uniform (#4E5B34). Stripped of the plate carrier, pouches, webbing, radio, grenade and backpack; the black visor is hidden and modelled eyes sit on the face. His RIGHT hand wears a bladed horror glove (module Bladed_glove, world mm): one steel blade per finger, each placed by a multmatrix whose axis is THAT finger's own direction (measured from the hand mesh by PCA), so the four blades splay with the fingers \u2014 a strip along the back of the finger, then a 2.5 mm blade curving toward the palm ~200 mm past the tip \u2014 with a leather cap and ring on each finger and a knuckle plate. Keeps the duty belt and holstered pistol, knee and elbow pads, shoulder patches and the helmet with NVG mount and headset. Stands on z = 0, facing -Y. Static (no skeleton).",
      "tags": [
       "soldier",
       "military",
       "army",
       "commando",
       "muscular",
       "character",
       "game",
       "horror",
       "claws",
       "finger blades",
       "green uniform"
      ]
     }
    },
