     "library": {
      "uid": "1945f2039d994ad996dd7632dde8c39c",
      "title": "Commando sergeant 2 m",
      "area": "Characters & monsters",
      "named": "Commando sergeant 2 m",
      "source": "assistant",
      "description": "A big, muscular soldier for games, made from the SWAT soldier 1.8 m (Quaternius CC0 low-poly body). Scaled to about 2.0 m tall and ~20 % broader and deeper (scale 1.22 x 1.2 x 1.12 node \"Bigger and broader\"), with sculpt inflate strokes (mirrored in x) bulking the shoulders, upper arms, forearms, upper back, neck and thighs. Olive-drab uniform (#4E5B34), the chest radio, antenna and grenade removed, the black visor hidden so his face shows, and modelled eyes (whites, green irises, pupils, emissive sparkle, brows) placed on the face. Keeps the plate carrier, magazine pouches, duty belt and holster, knee and elbow pads, hydration pack, patches and helmet with NVG mount and headset. Stands on z = 0, facing -Y. Static (no skeleton); the animated version is \"SWAT soldier (animated) 1.8 m\".",
      "tags": [
       "soldier",
       "military",
       "army",
       "commando",
       "muscular",
       "character",
       "game",
       "SWAT",
       "green uniform"
      ]
     }
    },
