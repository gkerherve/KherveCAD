     "library_part": "user_characters_monsters_swat_soldier_1_8_m",
     "library": {
      "uid": "1945f2039d994ad996dd7632dde8c39c",
      "title": "Bazooka trooper 1.2 m",
      "area": "Characters & monsters",
      "named": "Bazooka trooper 1.2 m",
      "source": "assistant",
      "description": "A short, stocky game character: a 1.2 m trooper in a red costume whose right forearm has been replaced by a bazooka. Built from the Commando / Nightmare sergeant (Quaternius CC0 SWAT body, broadened and sculpted), scaled down (node \"Down to 1.2 m\"). Body meshes are trimmed copies (meshes/trooper/trooper-1..3.stl: old helmet, right forearm and hand removed, collar trimmed). REALISTIC head: the MakeHuman-based human node (male, stature 1750 in the body's frame) intersected down to head and neck (module Real_head), chin sunk into the collar, with eyeballs, irises and pupils (module Eyes). Detailed open-face combat helmet sized to the head (module Combat_helmet): shell with brow and back rim edging, ear cut-outs with ear protectors, side rails, NVG shroud and mount, goggles with lenses on a strap round the shell, chin strap and cup, back patch. Bazooka arm (module Bazooka_arm): bolted socket at the elbow, short olive launch tube with band, sight, yellow warning stripe, flared muzzle and red armed light. Keeps the duty belt and holster, knee and elbow pads, shoulder patches. Stands on z = 0, facing -Y. Static. Work in progress \u2014 not shipped in the general library yet.",
      "tags": [
       "soldier",
       "trooper",
       "bazooka",
       "rocket launcher",
       "cyborg",
       "short",
       "character",
       "game",
       "red costume",
       "combat helmet",
       "realistic face"
      ]
     }
    },
