 "library": {
  "title": "Bazooka trooper 1.2 m",
  "description": "A short, stocky, SCARY game character: a 1.2 m trooper in an olive-green costume (#46552E) whose right forearm has been replaced by a bazooka. Built from the Commando / Nightmare sergeant (Quaternius CC0 SWAT body, broadened and sculpted), scaled down (node \"Down to 1.2 m\"). Body meshes are trimmed copies (meshes/trooper/trooper-1..3.stl: old helmet, right forearm and hand removed, collar trimmed). REALISTIC menacing head: the MakeHuman-based human node (male, stature 1750 in the body's frame) with face targets for a heavy angry brow, sunken cheeks, high cheekbones, square jaw, downturned mouth, hooked nose and eye bags; intersected down to head and neck (module Real_head), chin sunk into the collar; sickly pale skin mottled and darkened in the hollows by a weathering node; glowing red emissive irises with slit pupils (module Eyes); a stitched scar from brow over the left eye to the jaw (module Face_scar). Detailed open-face combat helmet (module Combat_helmet): rim edging, ear protectors, side rails, NVG mount, goggles on a strap, chin strap, back patch. Bazooka arm (module Bazooka_arm): bolted socket at the elbow, short olive launch tube, band, sight, warning stripe, flared muzzle, red light. Stands on z = 0, facing -Y. Static. Work in progress \u2014 not shipped in the general library yet.",
  "tags": [
   "soldier",
   "trooper",
   "bazooka",
   "rocket launcher",
   "cyborg",
   "scary",
   "villain",
   "scar",
   "red eyes",
   "green uniform",
   "character",
   "game",
   "combat helmet"
  ],
  "source": "assistant",
  "uid": "1945f2039d994ad996dd7632dde8c39c",
  "created": "2026-10-16T14:50:06"
 }
