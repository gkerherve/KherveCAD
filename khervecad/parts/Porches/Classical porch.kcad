 "library": {
  "title": "Classical porch",
  "description": "Classical porch: an entrance porch for the front door of a house \u2014 a portico with a stone platform and steps, white columns under an entablature and pediment. Overall about 4.1 x 2.6 x 4.4 m (width x depth x height). Stands on z = 0; place it against a facade with the door behind it. One of five porch styles (classical, craftsman, Victorian, rustic, modern) designed together.",
  "tags": [
   "porch",
   "entrance",
   "front door",
   "veranda",
   "house",
   "portico"
  ],
