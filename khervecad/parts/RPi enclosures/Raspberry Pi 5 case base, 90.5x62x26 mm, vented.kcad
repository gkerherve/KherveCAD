 },
 "library": {
  "title": "Raspberry Pi 5 case base, 90.5x62x26 mm, vented",
  "description": "Base of a two-part 3D-printable Raspberry Pi 5 enclosure, 90.5 x 62 x 26 mm. Walls and floor are 2 mm, vertical corners have a 4 mm radius and the bottom edges a 2 mm fillet. The frame matches the 'Raspberry Pi 5 board, 85x56 mm, detailed' library part, with the PCB underside at z=5. Four 7 mm standoffs, 3 mm tall, sit at the M2.5 holes (3.5,3.5), (61.5,3.5), (3.5,52.5), (61.5,52.5). Each has a 2.7 mm through hole and a 5 mm counterbore 2.7 mm deep, so M2.5 socket heads inserted from below sit flush. Openings: right wall for Ethernet and 2x stacked USB; front wall for USB-C, 2x micro-HDMI (sized for plug overmolds), a camera ribbon slot and vents; left wall for microSD, a power-button hole, an LED window and intake vents; back wall for 14 exhaust slots. There are floor vents under the SoC and four 8.5 mm rubber-foot recesses. About 19 mm of height is left above the PCB for the Active Cooler. It pairs with the rounded lid and 4x M2.5x8 screws and nuts. Print the base upright.",
  "tags": [
   "raspberry pi 5",
   "rpi5",
   "case",
   "enclosure",
   "box",
   "3d print",
   "vented",
   "rounded"
  ],
  "source": "assistant",
  "uid": "8bbe7e2b72f14bde926c5dfb609bf9a9",
  "created": "2026-09-28T10:49:27"
 }
