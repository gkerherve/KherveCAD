     "library": {
      "uid": "b262db300adb4a6895f207c1f3c2f490",
      "title": "Compound optical microscope, binocular, 400 mm tall",
      "area": "Science &amp; space",
      "named": "Compound optical microscope",
      "source": "assistant",
      "description": "A laboratory compound (biological) optical microscope, binocular head, modelled at true scale: about 210 mm wide, 250 mm deep and 400 mm tall, standing on its own base with the origin at the centre of the base and z = 0 at the bench top, so it can be dropped straight onto a bench by setting x / y / z on the Object. Built from primitives only (no booleans), about 35 coloured statements. Parts, bottom to top: hulled horseshoe base in dark grey, cylindrical lamp housing with a pale yellow lamp lens, condenser on its mount with a side focus knob, a hulled two-segment C arm rising at the back (+y) carrying coarse (d 74) and fine (d 44) focus knobs on both sides, a white mechanical stage 160 x 140 mm at z = 166 with a pale blue specimen slide, two slide clips and X/Y stage knobs on the left, a revolving nosepiece (d 104) with three objectives banded red (40x), yellow (10x) and green (4x), and a head with a binocular trunk and two eyepiece tubes inclined 45 degrees toward the front (-y), so the user's side is -y and the arm is at the back. No parameters or variables: edit the literal dimensions in the tree, or scale the Object, to change the size. Colours are set per statement, so recolouring the body means changing the '#3a3f45' and '#2b2f34' colour nodes.",
      "tags": [
       "microscope",
       "optical microscope",
       "compound microscope",
       "binocular microscope",
       "biological microscope",
       "lab",
       "laboratory",
       "bench",
       "eyepiece",
       "objective",
       "stage",
       "science",
       "school",
       "microscope optique",
       "Mikroskop"
      ]
     }
    },
